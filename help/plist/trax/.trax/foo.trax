# When a track is loaded, Trax looks for sidecars that hold track metadata,
# first checking `.trax/filename.trax`, then `filename.trax`.

# It is at this time that metadata traversal occurs.
!include       =../b.trax

track          =1
title          =Foo (bar)

[0]            >chap1.trax
[1:23.456]     >chap2.trax
